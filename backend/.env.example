PORT=5000
NODE_ENV=development
JWT_SECRET=outreachflow_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=outreachflow
DB_CONNECTION_LIMIT=10

# Frontend URL
CORS_ORIGIN=http://localhost:5173

# Ethereal Email SMTP Delivery & Web Preview (Testing)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
EMAIL_FROM=outreachflow@ethereal.email
EMAIL_FROM_NAME=OutreachFlow

# Transactional Email Delivery (Optional Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
