PORT=5000
NODE_ENV=development
JWT_SECRET=outreachflow_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=outreachflow
DB_CONNECTION_LIMIT=10

# Frontend URL
CORS_ORIGIN=http://localhost:5173

# Transactional Email Delivery (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=OutreachFlow
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
